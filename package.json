{
  "name": "openwire",
  "version": "1.2.1",
  "description": "OpenAPI-to-MCP server: turn API specifications into validated tools for AI clients.",
  "author": "Moad Tellami",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "openapi3",
    "swagger",
    "llm",
    "ai",
    "bridge",
    "api",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtellami/openwire.git"
  },
  "homepage": "https://github.com/mtellami/openwire#readme",
  "bugs": {
    "url": "https://github.com/mtellami/openwire/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openwire": "dist/index.js",
    "api-mcp-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "fmt": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:package",
    "test:package": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-types": "^12.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.1.2",
    "oxlint": "^1.78.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3"
  }
}
